{
  "entities": {
    "PublicBranding": {
      "title": "PublicBranding",
      "description": "Non-sensitive team branding displayed on the sign-in screen.",
      "type": "object",
      "properties": {
        "appName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "teamName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "secondaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "logo": { "type": "string", "maxLength": 180000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appName", "teamName", "primaryColor", "secondaryColor", "updatedAt"]
    },
    "TeamSettings": {
      "title": "TeamSettings",
      "description": "Team configuration managed exclusively by the Captain.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "appName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "teamName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "secondaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "logo": { "type": "string", "maxLength": 180000 },
        "inviteCode": { "type": "string", "pattern": "^[A-Z0-9\\-]{8,20}$", "minLength": 8, "maxLength": 20 },
        "memberShareCode": { "type": "string", "pattern": "^[A-Z0-9\\-]{8,20}$", "minLength": 8, "maxLength": 20 },
        "requireApproval": { "type": "boolean" },
        "lockSkills": { "type": "boolean" },
        "themeVersion": { "type": "string", "maxLength": 24 },
        "creatorUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "organizerUids": { "type": "array", "items": { "type": "string" } },
        "lineupPermission": { "type": "string", "enum": ["all", "organizers"] },
        "defaultCurrency": { "type": "string", "minLength": 1, "maxLength": 20 },
        "defaultPitchCost": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "appName", "teamName", "primaryColor", "secondaryColor", "inviteCode", "requireApproval", "lockSkills", "themeVersion", "updatedAt"]
    },
    "InviteCode": {
      "title": "InviteCode",
      "description": "PII-free smart team invite code verified by document ID with single/multi usage quota, expiration, member-share enforcement, revocation status, and team branding preview.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9\\-]{8,20}$", "minLength": 8, "maxLength": 20 },
        "active": { "type": "boolean" },
        "requireApproval": { "type": "boolean" },
        "isMemberShareCode": { "type": "boolean" },
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "teamName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "appName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "usageType": { "type": "string", "enum": ["single", "multi"] },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "durationDays": { "type": "number" },
        "createdAtMs": { "type": "number" },
        "expiresAtMs": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "revoked", "expired", "completed"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "active", "requireApproval", "isMemberShareCode", "teamId", "teamName", "appName", "primaryColor", "usageType", "maxUses", "usedCount", "durationDays", "createdAtMs", "expiresAtMs", "status", "updatedAt"]
    },
    "InviteAdminLog": {
      "title": "InviteAdminLog",
      "description": "Private Captain-only audit metadata for invite codes (createdBy / revokedBy isolated from public inviteCodes).",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9\\-]{8,20}$", "minLength": 8, "maxLength": 20 },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "revokedBy": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted RBAC table of promoted captains keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "promotedBy": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "promotedBy", "createdAt"]
    },
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Team roster player card (no PII, no PINs, no medical details).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "role": { "type": "string", "enum": ["admin", "player"] },
        "jersey": { "type": "number" },
        "age": { "type": "number" },
        "height": { "type": "number" },
        "weight": { "type": "number" },
        "foot": { "type": "string", "enum": ["يمين", "يسار", "كلتاهما"] },
        "primaryPos": { "type": "string", "enum": ["حارس مرمى", "مدافع", "لاعب وسط", "جناح", "مهاجم"] },
        "secondaryPos": { "type": "string", "enum": ["لا يوجد", "حارس مرمى", "مدافع", "لاعب وسط", "جناح", "مهاجم"] },
        "photoZoom": { "type": "number" },
        "photoY": { "type": "number" },
        "hasPhoto": { "type": "boolean" },
        "skills": { "type": "object" },
        "stats6": { "type": "object" },
        "roleOverride": { "type": "string", "enum": ["", "ST", "CAM_WINGER", "CM", "DEF_CB", "GK"] },
        "top3Strengths": { "type": "string", "maxLength": 200 },
        "weak3Points": { "type": "string", "maxLength": 200 },
        "seasonGoal": { "type": "string", "maxLength": 200 },
        "availability": { "type": "string", "maxLength": 120 },
        "availableStatus": { "type": "string", "enum": ["available", "unavailable"] },
        "roleModelStarId": { "type": "string", "pattern": "^[a-z0-9_]*$", "maxLength": 40 },
        "referredBy": { "type": "string", "pattern": "^(REF-[A-Z0-9]{4,16})?$", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teamId", "ownerUid", "name", "role", "jersey", "primaryPos", "skills", "availableStatus", "createdAt", "updatedAt"]
    },
    "PlayerPhoto": {
      "title": "PlayerPhoto",
      "description": "Compressed JPEG player portrait stored separately from roster docs to stay well below Firestore 1MB limits.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "playerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "dataUrl": { "type": "string", "maxLength": 250000 },
        "photoZoom": { "type": "number" },
        "photoY": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "playerId", "ownerUid", "dataUrl", "photoZoom", "photoY", "updatedAt"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Pending request to join the team keyed by applicant Firebase Auth UID to prevent duplicates.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "jersey": { "type": "number" },
        "primaryPos": { "type": "string", "enum": ["حارس مرمى", "مدافع", "لاعب وسط", "جناح", "مهاجم"] },
        "stats6": { "type": "object" },
        "roleOverride": { "type": "string", "enum": ["", "ST", "CAM_WINGER", "CM", "DEF_CB", "GK"] },
        "inviteCode": { "type": "string", "pattern": "^[A-Z0-9\\-]{8,20}$", "minLength": 8, "maxLength": 20 },
        "referredBy": { "type": "string", "pattern": "^(REF-[A-Z0-9]{4,16})?$", "maxLength": 32 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "jersey", "primaryPos", "inviteCode", "status", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Player match attendance confirmation.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "playerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "playerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "type": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["جاي", "محتمل", "معتذر"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "playerId", "ownerUid", "playerName", "date", "type", "status", "createdAt", "updatedAt"]
    },
    "ReadinessRecord": {
      "title": "ReadinessRecord",
      "description": "Private pre-match readiness log accessible strictly by owner and Captain.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "playerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "sleep": { "type": "number" },
        "fatigue": { "type": "number" },
        "mood": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "playerId", "ownerUid", "date", "sleep", "fatigue", "mood", "createdAt"]
    },
    "InjuryRecord": {
      "title": "InjuryRecord",
      "description": "Private injury log accessible strictly by owner and Captain.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "playerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "location": { "type": "string", "minLength": 1, "maxLength": 100 },
        "severity": { "type": "string", "enum": ["خفيفة", "متوسطة", "شديدة"] },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "expectedReturn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "playerId", "ownerUid", "type", "location", "severity", "date", "expectedReturn", "createdAt"]
    },
    "MatchRecord": {
      "title": "MatchRecord",
      "description": "Official team match score recorded by Captain.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "opponent": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ourScore": { "type": "number" },
        "oppScore": { "type": "number" },
        "result": { "type": "string", "enum": ["فوز", "تعادل", "خسارة"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "date", "opponent", "ourScore", "oppScore", "result", "createdBy", "createdAt"]
    },
    "MatchReport": {
      "title": "MatchReport",
      "description": "Post-match player performance report.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "playerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "playerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "opponent": { "type": "string", "minLength": 1, "maxLength": 80 },
        "goals": { "type": "number" },
        "assists": { "type": "number" },
        "minutes": { "type": "number" },
        "interceptions": { "type": "number" },
        "turnovers": { "type": "number" },
        "rating": { "type": "number" },
        "rpe": { "type": "number" },
        "bestMoment": { "type": "string", "maxLength": 200 },
        "worstMoment": { "type": "string", "maxLength": 200 },
        "motmVote": { "type": "string", "maxLength": 128 },
        "pitchMode": { "type": "string", "enum": ["5v5", "6v6", "7v7", "11v11"] },
        "matchResult": { "type": "string", "enum": ["فوز", "تعادل", "خسارة"] },
        "goalsConceded": { "type": "number" },
        "matchSessionId": { "type": "string", "maxLength": 128 },
        "confirmedByUids": { "type": "array", "items": { "type": "string" } },
        "verified": { "type": "boolean" },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "playerId", "ownerUid", "playerName", "opponent", "goals", "assists", "minutes", "rating", "confirmedByUids", "verified", "createdAtMs", "createdAt", "updatedAt"]
    },
    "ReportThrottle": {
      "title": "ReportThrottle",
      "description": "Server-enforced 45-minute anti-XP-farming report cooldown per player UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "lastReportAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "teamId", "lastReportAtMs", "updatedAt"]
    },
    "PeerRatingBallot": {
      "title": "PeerRatingBallot",
      "description": "Private anonymous ballot readable only by its own author; never listable and never self-targeted.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "raterUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "score": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetId", "raterUid", "score", "createdAt", "updatedAt"]
    },
    "PeerRatingStat": {
      "title": "PeerRatingStat",
      "description": "Aggregated anonymous peer rating totals without rater identity; readable only once count >= 3.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "targetId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "count": { "type": "number" },
        "totalScore": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "targetId", "count", "totalScore", "updatedAt"]
    },
    "AdminRating": {
      "title": "AdminRating",
      "description": "Captain evaluation for a player.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "targetId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "score": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "targetId", "score", "updatedAt"]
    },
    "SuggestionRecord": {
      "title": "SuggestionRecord",
      "description": "Anonymous team suggestion (no authorUid stored).",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "text", "createdAt"]
    },
    "TacticsConfig": {
      "title": "TacticsConfig",
      "description": "Saved team formation and pitch player slots.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "formation": { "type": "string", "enum": ["2-2-1", "1-2-2", "2-1-2", "3-1-1", "1-3-1", "1-2-1", "2-2", "1-1-2", "2-3-1", "3-2-1", "2-2-2", "4-3-3", "4-2-3-1", "3-5-2", "4-4-2"] },
        "slots": { "type": "object" },
        "publishedByUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "publishedByName": { "type": "string", "maxLength": 80 },
        "publishedAtMs": { "type": "number" },
        "previousSnapshot": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "formation", "slots", "updatedAt"]
    },
    "LineupVote": {
      "title": "LineupVote",
      "description": "Team member approval or swap vote on the published team lineup.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "vote": { "type": "string", "enum": ["approve", "swap"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "uid", "vote", "updatedAt"]
    },
    "PitchSession": {
      "title": "PitchSession",
      "description": "Upcoming match schedule and aggregate pitch fee totals (no per-player payment identity).",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "matchDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "matchTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "maxLength": 5 },
        "venue": { "type": "string", "minLength": 1, "maxLength": 80 },
        "totalCost": { "type": "number" },
        "currency": { "type": "string", "minLength": 1, "maxLength": 20 },
        "confirmedCount": { "type": "number" },
        "paidCount": { "type": "number" },
        "paidTotal": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "title", "matchDate", "matchTime", "venue", "totalCost", "currency", "confirmedCount", "paidCount", "paidTotal", "updatedAt"]
    },
    "PitchPayment": {
      "title": "PitchPayment",
      "description": "Private per-player pitch fee payment record readable strictly by owner and Captain.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "sessionId": { "type": "string", "enum": ["current"] },
        "playerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "playerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "amount": { "type": "number" },
        "paid": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "sessionId", "playerId", "ownerUid", "playerName", "amount", "paid", "updatedAt"]
    },
    "MatchSession": {
      "title": "MatchSession",
      "description": "Decentralized match verification session (Draft -> Verified by 3 distinct participants) with secret voting participation tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "teamId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 32 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "opponent": { "type": "string", "minLength": 1, "maxLength": 80 },
        "pitchMode": { "type": "string", "enum": ["5v5", "6v6", "7v7", "11v11"] },
        "ourScore": { "type": "number" },
        "oppScore": { "type": "number" },
        "result": { "type": "string", "enum": ["فوز", "تعادل", "خسارة"] },
