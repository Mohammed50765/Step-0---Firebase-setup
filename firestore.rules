        ]) &&
        isValidId(sessionId) &&
        data.id == sessionId &&
        data.teamId == tid &&
        isValidDateStr(data.date) &&
        data.opponent is string && data.opponent.size() >= 1 && data.opponent.size() <= 80 &&
        data.pitchMode in ['5v5', '6v6', '7v7', '11v11'] &&
        data.ourScore is number && data.ourScore >= 0 && data.ourScore <= 99 &&
        data.oppScore is number && data.oppScore >= 0 && data.oppScore <= 99 &&
        data.result in ['فوز', 'تعادل', 'خسارة'] &&
        isValidId(data.createdBy) &&
        data.participantIds is list && data.participantIds.size() >= 2 && data.participantIds.size() <= 22 &&
        data.confirmers is list && data.confirmers.size() >= 1 && data.confirmers.size() <= 22 &&
        data.status in ['draft', 'verified'] &&
        data.votingOpen is bool &&
        data.voterUids is list && data.voterUids.size() <= 22 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidMatchSession(data, sessionId) {
      return isValidMatchSessionForTeam(data, 'main', sessionId);
    }

    function isValidMatchVoteBallot(data, ballotId) {
      return data.keys().hasAll(['sessionId', 'targetId', 'voterUid', 'score', 'createdAt']) &&
        data.keys().hasOnly(['sessionId', 'targetId', 'voterUid', 'score', 'createdAt']) &&
        isValidId(data.sessionId) &&
        isValidId(data.targetId) &&
        isValidId(data.voterUid) &&
        data.voterUid == request.auth.uid &&
        data.targetId != request.auth.uid &&
        ballotId == (data.sessionId + '__' + data.targetId + '__' + request.auth.uid) &&
        data.score is int && data.score >= 1 && data.score <= 10 &&
        data.createdAt == request.time;
    }

    function isValidMatchVoteTallyForTeam(data, tid, tallyId) {
      return data.keys().hasAll([
          'teamId', 'sessionId', 'targetId', 'eligibleCount', 'count', 'totalScore',
          'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9', 'h10', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'teamId', 'sessionId', 'targetId', 'eligibleCount', 'count', 'totalScore',
          'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9', 'h10', 'updatedAt'
        ]) &&
        isValidId(tallyId) &&
        data.teamId == tid &&
        isValidId(data.sessionId) &&
        isValidId(data.targetId) &&
        tallyId == (data.sessionId + '__' + data.targetId) &&
        data.eligibleCount is int && data.eligibleCount >= 2 && data.eligibleCount <= 22 &&
        data.count is int && data.count >= 1 && data.count <= 22 &&
        data.totalScore is int && data.totalScore >= 1 && data.totalScore <= 220 &&
        isValidVoteBucket(data.h1) &&
        isValidVoteBucket(data.h2) &&
        isValidVoteBucket(data.h3) &&
        isValidVoteBucket(data.h4) &&
        isValidVoteBucket(data.h5) &&
        isValidVoteBucket(data.h6) &&
        isValidVoteBucket(data.h7) &&
        isValidVoteBucket(data.h8) &&
        isValidVoteBucket(data.h9) &&
        isValidVoteBucket(data.h10) &&
        (data.h1 + data.h2 + data.h3 + data.h4 + data.h5 + data.h6 + data.h7 + data.h8 + data.h9 + data.h10) == data.count &&
        (data.h1 * 1 + data.h2 * 2 + data.h3 * 3 + data.h4 * 4 + data.h5 * 5 + data.h6 * 6 + data.h7 * 7 + data.h8 * 8 + data.h9 * 9 + data.h10 * 10) == data.totalScore &&
        data.updatedAt == request.time;
    }

    function isValidMatchVoteTally(data, tallyId) {
      return isValidMatchVoteTallyForTeam(data, 'main', tallyId);
    }

    function isValidMissionClaimForTeam(data, tid, claimId) {
      return data.keys().hasAll([
          'id', 'teamId', 'missionId', 'missionTitle', 'xpReward',
          'claimantUid', 'claimantName', 'note', 'verifierUids',
          'approverUids', 'rejectorUids', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'teamId', 'missionId', 'missionTitle', 'xpReward',
          'claimantUid', 'claimantName', 'note', 'verifierUids',
          'approverUids', 'rejectorUids', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(claimId) &&
        data.id == claimId &&
        data.teamId == tid &&
        data.missionId in ['clean_sheet', 'team_assists', 'tactical_discipline', 'punctual_hero'] &&
        data.missionTitle is string && data.missionTitle.size() >= 1 && data.missionTitle.size() <= 80 &&
        data.xpReward is int && data.xpReward >= 10 && data.xpReward <= 100 &&
        isValidId(data.claimantUid) &&
        data.claimantName is string && data.claimantName.size() >= 1 && data.claimantName.size() <= 80 &&
        data.note is string && data.note.size() <= 200 &&
        data.verifierUids is list && data.verifierUids.size() == 2 &&
        data.verifierUids[0] is string && data.verifierUids[1] is string &&
        data.verifierUids[0] != data.verifierUids[1] &&
        !(data.claimantUid in data.verifierUids) &&
        data.approverUids is list && data.approverUids.size() <= 2 &&
        data.rejectorUids is list && data.rejectorUids.size() <= 2 &&
        data.status in ['pending', 'verified', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidMissionClaim(data, claimId) {
      return isValidMissionClaimForTeam(data, 'main', claimId);
    }

    function isValidLibraryCategory(c) {
      return c in [
        'التكتيكات والخطط',
        'أساسيات المراكز والأدوار',
        'مهارات المراوغة والتحكم',
        'التمرير وصناعة اللعب',
        'التسديد والإنهاء',
        'التحركات بدون كرة',
        'الضغط الجماعي',
        'التدريب الفردي',
        'اللياقة والتحمل',
        'الإحماء والتعافي',
        'تطوير الحراس',
        'القواعد الكروية',
        'الوقاية من الإصابات والإسعافات'
      ];
    }

    function isValidLibraryArticleForTeam(data, tid, articleId) {
      return data.keys().hasAll([
          'id', 'teamId', 'titleAr', 'originalLang', 'publisher', 'sourceUrl',
          'publishedAt', 'lastReviewed', 'category', 'level', 'summaryAr',
          'keyTakeawaysAr', 'terms', 'originalExcerpt', 'published', 'isCustom',
          'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'teamId', 'titleAr', 'originalLang', 'publisher', 'sourceUrl',
          'publishedAt', 'lastReviewed', 'category', 'level', 'summaryAr',
          'keyTakeawaysAr', 'terms', 'originalExcerpt', 'published', 'isCustom',
          'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(articleId) &&
        data.id == articleId &&
        data.teamId == tid &&
        data.titleAr is string && data.titleAr.size() >= 3 && data.titleAr.size() <= 140 &&
        data.originalLang is string && data.originalLang.size() >= 2 && data.originalLang.size() <= 40 &&
        data.publisher is string && data.publisher.size() >= 2 && data.publisher.size() <= 100 &&
        data.sourceUrl is string && data.sourceUrl.size() >= 12 && data.sourceUrl.size() <= 300 &&
        data.sourceUrl.matches('^https://[A-Za-z0-9._~:/?#\\[\\]@!$&\'()*+,;=%-]+$') &&
        isValidDateStr(data.publishedAt) &&
        isValidDateStr(data.lastReviewed) &&
        isValidLibraryCategory(data.category) &&
        data.level in ['مبتدئ', 'متوسط', 'متقدم'] &&
        data.summaryAr is string && data.summaryAr.size() >= 10 && data.summaryAr.size() <= 1200 &&
        data.keyTakeawaysAr is list && data.keyTakeawaysAr.size() >= 1 && data.keyTakeawaysAr.size() <= 6 &&
        data.keyTakeawaysAr[0] is string && data.keyTakeawaysAr[0].size() >= 2 && data.keyTakeawaysAr[0].size() <= 200 &&
        data.terms is list && data.terms.size() >= 1 && data.terms.size() <= 8 &&
        data.terms[0] is map &&
        data.terms[0].keys().hasAll(['en', 'ar']) &&
        data.terms[0].keys().hasOnly(['en', 'ar']) &&
        data.terms[0].en is string && data.terms[0].en.size() >= 1 && data.terms[0].en.size() <= 50 &&
        data.terms[0].ar is string && data.terms[0].ar.size() >= 1 && data.terms[0].ar.size() <= 60 &&
        data.originalExcerpt is string && data.originalExcerpt.size() <= 350 &&
        data.published is bool &&
        data.isCustom is bool &&
        isValidId(data.updatedBy) &&
        data.updatedBy == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidLibraryArticle(data, articleId) {
      return isValidLibraryArticleForTeam(data, 'main', articleId);
    }

    // ==================== 3. SHARED ROOT & LEGACY SINGLE-TEAM COLLECTIONS ====================

    // Global platform Spark quota kill-switch (verified users get config; Platform Owner admins/{uid} updates)
    match /platform/{docId} {
      allow get: if isVerifiedUser() && docId == 'config';
      allow list: if false;
      allow create, update: if isVerifiedUser() && docId == 'config' && isValidPlatformConfig(incoming()) && isCaptain();
      allow delete: if false;
    }

    // Strictly self-only User Multi-Team Registry (zero cross-user snooping or listing)
    match /users/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && uid == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedUser() && uid == request.auth.uid && isValidUserAccount(incoming(), uid);
      allow update: if isVerifiedUser() &&
        uid == request.auth.uid &&
        isValidUserAccount(incoming(), uid) &&
        incoming().uid == existing().uid;
      allow delete: if isVerifiedUser() && isValidId(uid) && uid == request.auth.uid;
    }

    // Public non-sensitive branding (login screen)
    match /publicMeta/{docId} {
      allow get: if isVerifiedUser() && docId == 'branding';
      allow list: if false;
      allow create, update: if isVerifiedUser() && docId == 'branding' && isValidPublicBranding(incoming()) && isCaptain();
      allow delete: if false;
    }

    // Team settings (Captain Tier 1 writes; Organizers Tier 2 limited update; team members read)
    match /settings/{docId} {
      allow get: if isVerifiedUser() && docId == 'team' && isTeamMember();
      allow list: if false;
      allow create: if isVerifiedUser() && docId == 'team' && isValidTeamSettings(incoming()) && isCaptain();
      allow update: if isVerifiedUser() && docId == 'team' && isValidTeamSettings(incoming()) && (
        isCaptain() ||
        (
          isOrganizer() &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'teamName', 'logo', 'defaultCurrency', 'defaultPitchCost', 'lineupPermission', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    // Smart Invite Codes (Shared across Single-Team main & Multi-Team teams/{teamId}; zero PII):
    // - Single-doc get by exact unguessable CSPRNG code allowed ONLY for email-verified users.
    // - List/Create/Delete scoped strictly to owning team Captain/Founder.
    // - Update allowed for owning Captain/Founder OR atomically paired with applicant joinRequest (+1 usedCount).
    match /inviteCodes/{code} {
      allow get: if isVerifiedUser() && isValidInviteCodeStr(code);
      allow list: if isCaptain() || (
        isVerifiedUser() &&
        isValidTeamId(resource.data.teamId) &&
        exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) &&
        get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.founderUid == request.auth.uid
      );
      allow create: if isVerifiedUser() &&
        isValidInviteCodeDoc(incoming(), code) && (
          (incoming().teamId == 'main' && isCaptain()) ||
          (incoming().teamId != 'main' && (isMultiFounder(incoming().teamId) || isMultiFounderAfter(incoming().teamId)))
        );
      allow update: if isVerifiedUser() &&
        isValidInviteCodeDoc(incoming(), code) &&
        incoming().teamId == existing().teamId && (
          (existing().teamId == 'main' && isCaptain()) ||
          (existing().teamId != 'main' && isMultiFounder(existing().teamId)) ||
          (
            isValidInviteUsageIncrement(existing(), incoming()) && (
              (
                existing().teamId == 'main' &&
                !exists(/databases/$(database)/documents/players/$(request.auth.uid)) &&
                !exists(/databases/$(database)/documents/joinRequests/$(request.auth.uid)) &&
                existsAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)) &&
                getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.inviteCode == code &&
                getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.createdAt == request.time
              ) ||
              (
                isValidTeamId(existing().teamId) &&
                isMultiTeamActive(existing().teamId) &&
                !exists(/databases/$(database)/documents/teams/$(existing().teamId)/members/$(request.auth.uid)) &&
                !exists(/databases/$(database)/documents/teams/$(existing().teamId)/joinRequests/$(request.auth.uid)) &&
                existsAfter(/databases/$(database)/documents/teams/$(existing().teamId)/joinRequests/$(request.auth.uid)) &&
                getAfter(/databases/$(database)/documents/teams/$(existing().teamId)/joinRequests/$(request.auth.uid)).data.inviteCode == code &&
                getAfter(/databases/$(database)/documents/teams/$(existing().teamId)/joinRequests/$(request.auth.uid)).data.createdAt == request.time
              )
            )
          )
        );
      allow delete: if isVerifiedUser() && isValidInviteCodeStr(code) && (
        (existing().teamId == 'main' && isCaptain()) ||
        (existing().teamId != 'main' && isMultiFounder(existing().teamId))
      );
    }

    // Private Captain Audit Logs for Legacy Invite Codes
    match /inviteAdminLogs/{code} {
      allow get, list: if isCaptain();
      allow create, update: if isCaptain() && isValidInviteAdminLog(incoming(), code);
      allow delete: if isCaptain() && isValidInviteCodeStr(code);
    }

    // Trusted Platform Owner / Legacy Captain RBAC table
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isCaptain());
      allow list: if isVerifiedUser() && isCaptain();
      allow create: if isVerifiedUser() && isValidAdminRecord(incoming(), uid) && isCaptain();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(uid) && isCaptain() && uid != request.auth.uid;
    }

    // Team roster players (no PII, no PINs, no medical details)
    match /players/{playerId} {
      allow get: if isVerifiedUser() && isValidId(playerId) && (playerId == request.auth.uid || isTeamMember());
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();

      // Captain can create any roster player; non-captain direct join requires active inviteCode (never memberShareCode) via atomic joinRequest
      allow create: if isVerifiedUser() &&
        isValidPlayerProfile(incoming(), playerId) &&
        incoming().createdAt == request.time && (
          isCaptain() ||
          (
            playerId == request.auth.uid &&
            incoming().ownerUid == request.auth.uid &&
            incoming().role == 'player' &&
            existsAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)) &&
            getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.createdAt == request.time &&
            getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.status == 'approved' &&
            exists(/databases/$(database)/documents/inviteCodes/$(getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.inviteCode)) &&
            get(/databases/$(database)/documents/inviteCodes/$(getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.inviteCode)).data.active == true &&
            get(/databases/$(database)/documents/inviteCodes/$(getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.inviteCode)).data.requireApproval == false &&
            get(/databases/$(database)/documents/inviteCodes/$(getAfter(/databases/$(database)/documents/joinRequests/$(request.auth.uid)).data.inviteCode)).data.isMemberShareCode != true
          )
        );

      allow update: if isVerifiedUser() &&
        isValidPlayerProfile(incoming(), playerId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id &&
        incoming().teamId == existing().teamId && (
          isCaptain() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'jersey', 'age', 'height', 'weight', 'foot',
              'primaryPos', 'secondaryPos', 'photoZoom', 'photoY', 'hasPhoto',
              'skills', 'stats6', 'roleOverride', 'top3Strengths', 'weak3Points', 'seasonGoal',
              'availability', 'availableStatus', 'roleModelStarId', 'updatedAt'
            ]) &&
            (
              !incoming().diff(existing()).affectedKeys().hasAny(['skills', 'stats6']) ||
              !exists(/databases/$(database)/documents/settings/team) ||
              get(/databases/$(database)/documents/settings/team).data.lockSkills == false
            )
          )
        );

      allow delete: if isVerifiedUser() && isValidId(playerId) && (
        (isCaptain() && playerId != request.auth.uid) ||
        (playerId == request.auth.uid && !isCaptain())
      );
    }

    // Separate player portrait photos
    match /playerPhotos/{playerId} {
      allow get: if isVerifiedUser() && isValidId(playerId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();
      allow create, update: if isVerifiedUser() &&
        isValidPlayerPhoto(incoming(), playerId) && (
          isCaptain() ||
          (
            playerId == request.auth.uid &&
            incoming().ownerUid == request.auth.uid &&
            exists(/databases/$(database)/documents/players/$(playerId)) &&
            get(/databases/$(database)/documents/players/$(playerId)).data.ownerUid == request.auth.uid
          )
        );
      allow delete: if isVerifiedUser() && isValidId(playerId) && (isCaptain() || existing().ownerUid == request.auth.uid);
    }

    // Join requests (Legacy Single-Team)
    match /joinRequests/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isCaptain());
      allow list: if isVerifiedUser() && (isCaptain() || resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser() &&
        uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/players/$(request.auth.uid)) &&
        isValidJoinRequest(incoming(), uid) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)) &&
        get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.teamId == 'main' &&
        get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.active == true &&
        get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.status == 'active' &&
        request.time.toMillis() < get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.expiresAtMs &&
        get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.usedCount <
          get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.maxUses &&
        getAfter(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.usedCount ==
          get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.usedCount + 1 && (
          incoming().status == 'pending' ||
          (
            incoming().status == 'approved' &&
            get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.requireApproval == false &&
            get(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)).data.isMemberShareCode != true
          )
        );
      allow update: if isVerifiedUser() &&
        isValidJoinRequest(incoming(), uid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        existing().status == 'pending' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        isCaptain();
      allow delete: if isVerifiedUser() && isValidId(uid) && (
        isCaptain() ||
        (uid == request.auth.uid && existing().status in ['pending', 'approved', 'rejected'])
      );
    }

    // Attendance records (Legacy Single-Team)
    match /attendance/{attendanceId} {
      allow get: if isVerifiedUser() && isValidId(attendanceId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();
      allow create: if isVerifiedUser() &&
        isValidId(attendanceId) &&
        isValidAttendance(incoming()) &&
        incoming().createdAt == request.time &&
        isTeamMember() &&
        (isCaptain() || (incoming().playerId == request.auth.uid && incoming().ownerUid == request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(attendanceId) &&
        isValidAttendance(incoming()) &&
        isTeamMember() &&
        incoming().teamId == existing().teamId &&
        incoming().playerId == existing().playerId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        (isCaptain() || existing().ownerUid == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['playerName', 'date', 'type', 'status', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(attendanceId) && isCaptain();
    }

    // PRIVATE Readiness logs (Legacy Single-Team: Owner + Captain ONLY)
    match /readiness/{readinessId} {
      allow get: if isVerifiedUser() && isValidId(readinessId) &&
        (resource.data.ownerUid == request.auth.uid || isCaptain());
      allow list: if isVerifiedUser() &&
        (resource.data.ownerUid == request.auth.uid || isCaptain());
      allow create: if isVerifiedUser() &&
        isValidId(readinessId) &&
        isValidReadiness(incoming()) &&
        isTeamMember() &&
        (isCaptain() || (incoming().playerId == request.auth.uid && incoming().ownerUid == request.auth.uid));
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(readinessId) &&
        (isCaptain() || existing().ownerUid == request.auth.uid);
    }

    // PRIVATE Injury logs (Legacy Single-Team: Owner + Captain ONLY)
    match /injuries/{injuryId} {
      allow get: if isVerifiedUser() && isValidId(injuryId) &&
        (resource.data.ownerUid == request.auth.uid || isCaptain());
      allow list: if isVerifiedUser() &&
        (resource.data.ownerUid == request.auth.uid || isCaptain());
      allow create: if isVerifiedUser() &&
        isValidId(injuryId) &&
        isValidInjury(incoming()) &&
        isTeamMember() &&
        (isCaptain() || (incoming().playerId == request.auth.uid && incoming().ownerUid == request.auth.uid));
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(injuryId) &&
        (isCaptain() || existing().ownerUid == request.auth.uid);
    }

    // Match results (Legacy Single-Team)
    match /matches/{matchId} {
      allow get: if isVerifiedUser() && isValidId(matchId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();
      allow create: if isVerifiedUser() &&
        isValidId(matchId) &&
        isValidMatch(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        isCaptain();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(matchId) && isCaptain();
    }

    // Match reports (Legacy Single-Team)
    match /reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();
      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        isTeamMember() &&
        incoming().confirmedByUids.size() == 0 &&
        incoming().verified == false &&
        incoming().createdAt == request.time && (
          isCaptain() ||
          (
            incoming().playerId == request.auth.uid &&
            incoming().ownerUid == request.auth.uid &&
            existsAfter(/databases/$(database)/documents/reportThrottle/$(request.auth.uid)) &&
            getAfter(/databases/$(database)/documents/reportThrottle/$(request.auth.uid)).data.updatedAt == request.time
          )
        );
      allow update: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidReport(incoming()) &&
        isTeamMember() &&
        incoming().teamId == existing().teamId &&
        incoming().playerId == existing().playerId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().createdAtMs == existing().createdAtMs &&
        request.auth.uid != existing().ownerUid &&
        request.auth.uid != existing().playerId &&
        !(request.auth.uid in existing().confirmedByUids) &&
        request.auth.uid in incoming().confirmedByUids &&
        incoming().confirmedByUids.hasAll(existing().confirmedByUids) &&
        incoming().confirmedByUids.size() == existing().confirmedByUids.size() + 1 &&
        incoming().verified == true &&
        incoming().diff(existing()).affectedKeys().hasOnly(['confirmedByUids', 'verified', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(reportId) && isCaptain();
    }

    // Report Cooldown (Legacy Single-Team)
    match /reportThrottle/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isCaptain());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        uid == request.auth.uid &&
        isTeamMember() &&
        isValidReportThrottle(incoming(), uid);
      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        uid == request.auth.uid &&
        isTeamMember() &&
        isValidReportThrottle(incoming(), uid) &&
        request.time.toMillis() >= existing().updatedAt.toMillis() + 2700000;
      allow delete: if isVerifiedUser() && isValidId(uid) && isCaptain();
    }

    // Anonymous Raw Peer Ballots (Legacy Single-Team)
    match /peerRatings/{ratingId} {
      allow get: if isVerifiedUser() && isValidId(ratingId) && resource.data.raterUid == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(ratingId) &&
        isValidPeerBallot(incoming(), ratingId) &&
        incoming().createdAt == request.time &&
        isTeamMember() &&
        exists(/databases/$(database)/documents/players/$(incoming().targetId)) &&
        existsAfter(/databases/$(database)/documents/peerRatingStats/$(incoming().targetId));
      allow update: if isVerifiedUser() &&
        isValidId(ratingId) &&
        isValidPeerBallot(incoming(), ratingId) &&
        existing().raterUid == request.auth.uid &&
        incoming().raterUid == existing().raterUid &&
        incoming().targetId == existing().targetId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['score', 'updatedAt']) &&
        isTeamMember() &&
        existsAfter(/databases/$(database)/documents/peerRatingStats/$(incoming().targetId));
      allow delete: if false;
    }

    // Aggregated Peer Rating Stats (Legacy Single-Team)
    match /peerRatingStats/{targetId} {
      allow get: if isVerifiedUser() && isValidId(targetId) && isTeamMember() && resource.data.count >= 3;
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && resource.data.count >= 3 && isTeamMember();
      allow create: if isVerifiedUser() &&
        isValidPeerRatingStat(incoming(), targetId) &&
        targetId != request.auth.uid &&
        isTeamMember() &&
        exists(/databases/$(database)/documents/players/$(targetId)) &&
        !exists(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)) &&
        incoming().count == 1 &&
        incoming().totalScore == getAfter(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)).data.score;
      allow update: if isVerifiedUser() &&
        isValidPeerRatingStat(incoming(), targetId) &&
        targetId != request.auth.uid &&
        incoming().teamId == existing().teamId &&
        incoming().targetId == existing().targetId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['count', 'totalScore', 'updatedAt']) &&
        isTeamMember() &&
        existsAfter(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)) &&
        (
          (
            !exists(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)) &&
            incoming().count == existing().count + 1 &&
            incoming().totalScore == existing().totalScore + getAfter(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)).data.score
          ) ||
          (
            exists(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)) &&
            incoming().count == existing().count &&
            incoming().totalScore == existing().totalScore - get(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)).data.score + getAfter(/databases/$(database)/documents/peerRatings/$(targetId + '__' + request.auth.uid)).data.score
          )
        );
      allow delete: if isVerifiedUser() && isValidId(targetId) && isCaptain();
    }

    // Captain ratings (Legacy Single-Team)
    match /adminRatings/{targetId} {
      allow get: if isVerifiedUser() && isValidId(targetId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();
      allow create, update: if isVerifiedUser() && isValidAdminRating(incoming(), targetId) && isCaptain();
      allow delete: if isVerifiedUser() && isValidId(targetId) && isCaptain();
    }

    // Anonymous suggestions (Legacy Single-Team)
    match /suggestions/{suggestionId} {
      allow get: if isVerifiedUser() && isValidId(suggestionId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();
      allow create: if isVerifiedUser() &&
        isValidId(suggestionId) &&
        isValidSuggestion(incoming()) &&
        isTeamMember();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(suggestionId) && isCaptain();
    }

    // Team tactics (Legacy Single-Team)
    match /tactics/{docId} {
      allow get: if isVerifiedUser() && docId == 'current' && isTeamMember();
      allow list: if false;
      allow create, update: if isVerifiedUser() && docId == 'current' && isValidTactics(incoming()) && canPublishLineup();
      allow delete: if false;
    }

    // Team lineup votes (Legacy Single-Team)
    match /lineupVotes/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();
      allow create, update: if isVerifiedUser() &&
        isValidId(uid) &&
        uid == request.auth.uid &&
        isTeamMember() &&
        isValidLineupVote(incoming(), uid);
      allow delete: if isVerifiedUser() && isValidId(uid) && (isCaptain() || uid == request.auth.uid);
    }

    // Upcoming match schedule & aggregate pitch fee totals (Legacy Single-Team)
    match /pitchSessions/{docId} {
      allow get: if isVerifiedUser() && docId == 'current' && isTeamMember();
      allow list: if false;
      allow create, update: if isVerifiedUser() && docId == 'current' && isValidPitchSession(incoming()) && (isCaptain() || isOrganizer());
      allow delete: if false;
    }

    // PRIVATE per-player pitch fee payment records (Legacy Single-Team)
    match /pitchPayments/{paymentId} {
      allow get: if isVerifiedUser() && isValidId(paymentId) &&
        (resource.data.ownerUid == request.auth.uid || isCaptain());
      allow list: if isVerifiedUser() &&
        (resource.data.ownerUid == request.auth.uid || isCaptain());
      allow create, update: if isVerifiedUser() && isValidId(paymentId) &&
        isValidPitchPayment(incoming(), paymentId) && (isCaptain() || isOrganizer());
      allow delete: if isVerifiedUser() && isValidId(paymentId) && (isCaptain() || isOrganizer());
    }

    // Decentralized match verification (Legacy Single-Team)
    match /matchSessions/{sessionId} {
      allow get: if isVerifiedUser() && isValidId(sessionId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();

      allow create: if isVerifiedUser() &&
        isValidMatchSession(incoming(), sessionId) &&
        isTeamMember() &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().status == 'draft' &&
        incoming().votingOpen == false &&
        incoming().confirmers.size() == 1 &&
        request.auth.uid in incoming().confirmers &&
        request.auth.uid in incoming().participantIds &&
        incoming().voterUids.size() == 0;

      allow update: if isVerifiedUser() &&
        isValidMatchSession(incoming(), sessionId) &&
        isTeamMember() &&
        incoming().id == existing().id &&
        incoming().teamId == existing().teamId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().date == existing().date &&
        incoming().opponent == existing().opponent &&
        incoming().pitchMode == existing().pitchMode &&
        incoming().ourScore == existing().ourScore &&
        incoming().oppScore == existing().oppScore &&
        incoming().result == existing().result &&
        incoming().participantIds == existing().participantIds && (
          (
            existing().status == 'draft' &&
            request.auth.uid in existing().participantIds &&
            !(request.auth.uid in existing().confirmers) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['confirmers', 'status', 'votingOpen', 'updatedAt']) &&
            incoming().confirmers.size() == existing().confirmers.size() + 1 &&
            incoming().confirmers.hasAll(existing().confirmers) &&
            request.auth.uid in incoming().confirmers && (
              (incoming().confirmers.size() >= 3 && incoming().status == 'verified' && incoming().votingOpen == true) ||
              (incoming().confirmers.size() < 3 && incoming().status == 'draft' && incoming().votingOpen == false)
            )
          ) ||
          (
            existing().status == 'verified' &&
            existing().votingOpen == true &&
            request.auth.uid in existing().participantIds &&
            !(request.auth.uid in existing().voterUids) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['voterUids', 'updatedAt']) &&
            incoming().voterUids.size() == existing().voterUids.size() + 1 &&
            incoming().voterUids.hasAll(existing().voterUids) &&
            request.auth.uid in incoming().voterUids
          ) ||
          (
            isCaptain() &&
            existing().status == 'verified' &&
            existing().votingOpen == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['votingOpen', 'updatedAt']) &&
            incoming().votingOpen == false
          )
        );

      allow delete: if isVerifiedUser() && isValidId(sessionId) && isCaptain();
    }

    // PRIVATE Secret Match Ballots (Legacy Single-Team)
    match /matchVoteBallots/{ballotId} {
      allow get: if isVerifiedUser() && isValidId(ballotId) && resource.data.voterUid == request.auth.uid;
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(ballotId) &&
        isValidMatchVoteBallot(incoming(), ballotId) &&
        isTeamMember() &&
        exists(/databases/$(database)/documents/matchSessions/$(incoming().sessionId)) &&
        get(/databases/$(database)/documents/matchSessions/$(incoming().sessionId)).data.status == 'verified' &&
        get(/databases/$(database)/documents/matchSessions/$(incoming().sessionId)).data.votingOpen == true &&
        request.auth.uid in get(/databases/$(database)/documents/matchSessions/$(incoming().sessionId)).data.participantIds &&
        incoming().targetId in get(/databases/$(database)/documents/matchSessions/$(incoming().sessionId)).data.participantIds &&
        existsAfter(/databases/$(database)/documents/matchVoteTallies/$(incoming().sessionId + '__' + incoming().targetId));

      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(ballotId) && isCaptain();
    }

    // ANONYMOUS 10-Bucket Match Vote Tallies (Legacy Single-Team)
    match /matchVoteTallies/{tallyId} {
      allow get: if isVerifiedUser() &&
        isValidId(tallyId) &&
        isTeamMember() &&
        resource.data.count >= 2 &&
        exists(/databases/$(database)/documents/matchSessions/$(resource.data.sessionId)) &&
        get(/databases/$(database)/documents/matchSessions/$(resource.data.sessionId)).data.status == 'verified' &&
        (
          get(/databases/$(database)/documents/matchSessions/$(resource.data.sessionId)).data.voterUids.size() * 2 >=
          get(/databases/$(database)/documents/matchSessions/$(resource.data.sessionId)).data.participantIds.size()
        );
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidMatchVoteTally(incoming(), tallyId) &&
        incoming().targetId != request.auth.uid &&
        isTeamMember() &&
        !exists(/databases/$(database)/documents/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
        incoming().count == 1 &&
        incoming().totalScore == getAfter(/databases/$(database)/documents/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)).data.score;

      allow update: if isVerifiedUser() &&
        isValidMatchVoteTally(incoming(), tallyId) &&
        incoming().targetId != request.auth.uid &&
        incoming().teamId == existing().teamId &&
        incoming().sessionId == existing().sessionId &&
        incoming().targetId == existing().targetId &&
        incoming().eligibleCount == existing().eligibleCount &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'count', 'totalScore', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9', 'h10', 'updatedAt'
        ]) &&
        isTeamMember() &&
        !exists(/databases/$(database)/documents/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
        existsAfter(/databases/$(database)/documents/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
        incoming().count == existing().count + 1 &&
        incoming().totalScore == existing().totalScore + getAfter(/databases/$(database)/documents/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)).data.score &&
        incoming().h1 >= existing().h1 &&
        incoming().h2 >= existing().h2 &&
        incoming().h3 >= existing().h3 &&
        incoming().h4 >= existing().h4 &&
        incoming().h5 >= existing().h5 &&
        incoming().h6 >= existing().h6 &&
        incoming().h7 >= existing().h7 &&
        incoming().h8 >= existing().h8 &&
        incoming().h9 >= existing().h9 &&
        incoming().h10 >= existing().h10;

      allow delete: if isVerifiedUser() && isValidId(tallyId) && isCaptain();
    }

    // Random 2-Teammate Peer Mission Verification (Legacy Single-Team)
    match /missionClaims/{claimId} {
      allow get: if isVerifiedUser() && isValidId(claimId) && isTeamMember();
      allow list: if isVerifiedUser() && resource.data.teamId == 'main' && isTeamMember();

      allow create: if isVerifiedUser() &&
        isValidMissionClaim(incoming(), claimId) &&
        isTeamMember() &&
        incoming().claimantUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().approverUids.size() == 0 &&
        incoming().rejectorUids.size() == 0 &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/players/$(incoming().verifierUids[0])) &&
        exists(/databases/$(database)/documents/players/$(incoming().verifierUids[1]));

      allow update: if isVerifiedUser() &&
        isValidMissionClaim(incoming(), claimId) &&
        isTeamMember() &&
        existing().status == 'pending' &&
        incoming().id == existing().id &&
        incoming().teamId == existing().teamId &&
        incoming().missionId == existing().missionId &&
        incoming().missionTitle == existing().missionTitle &&
        incoming().xpReward == existing().xpReward &&
        incoming().claimantUid == existing().claimantUid &&
        incoming().claimantName == existing().claimantName &&
        incoming().note == existing().note &&
        incoming().verifierUids == existing().verifierUids &&
        incoming().createdAt == existing().createdAt &&
        request.auth.uid != existing().claimantUid &&
        request.auth.uid in existing().verifierUids &&
        !(request.auth.uid in existing().approverUids) &&
        !(request.auth.uid in existing().rejectorUids) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['approverUids', 'rejectorUids', 'status', 'updatedAt']) && (
          (
            incoming().rejectorUids == existing().rejectorUids &&
            incoming().approverUids.size() == existing().approverUids.size() + 1 &&
            incoming().approverUids.hasAll(existing().approverUids) &&
            request.auth.uid in incoming().approverUids && (
              (incoming().approverUids.size() == 2 && incoming().status == 'verified') ||
              (incoming().approverUids.size() < 2 && incoming().status == 'pending')
            )
          ) ||
          (
            incoming().approverUids == existing().approverUids &&
            incoming().rejectorUids.size() == existing().rejectorUids.size() + 1 &&
            incoming().rejectorUids.hasAll(existing().rejectorUids) &&
            request.auth.uid in incoming().rejectorUids &&
            incoming().status == 'rejected'
          )
        );

      allow delete: if isVerifiedUser() && isValidId(claimId) && isCaptain();
    }

    // Global Football Library (Legacy Single-Team)
    match /footballLibrary/{articleId} {
      allow get: if isVerifiedUser() &&
        isValidId(articleId) &&
        isTeamMember() &&
        (resource.data.published == true || isCaptain());

      allow list: if isVerifiedUser() &&
        resource.data.teamId == 'main' &&
        isTeamMember() &&
        (resource.data.published == true || isCaptain());

      allow create: if isVerifiedUser() &&
        isValidLibraryArticle(incoming(), articleId) &&
        incoming().createdAt == request.time &&
        isCaptain();

      allow update: if isVerifiedUser() &&
        isValidLibraryArticle(incoming(), articleId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id &&
        incoming().teamId == existing().teamId &&
        isCaptain();

      allow delete: if isVerifiedUser() && isValidId(articleId) && isCaptain();
    }

    // ==================== 4. PHASE 6: MULTI-TEAM ISOLATED TENANCY (/teams/{teamId}) ====================
    // Zero cross-team visibility; Platform Owners (admins/{uid}) have ZERO access to other teams unless member/founder.

    match /teams/{teamId} {
      allow get: if isVerifiedUser() && isValidTeamId(teamId) && (
        (resource != null && resource.data.founderUid == request.auth.uid) ||
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/teams/$(teamId)/joinRequests/$(request.auth.uid))
      );
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidTeamId(teamId) &&
        isValidMultiTeam(incoming(), teamId) &&
        incoming().founderUid == request.auth.uid &&
        incoming().deletedAt == null &&
        (!('createdAt' in incoming()) || incoming().createdAt == request.time) && (
          // Standard Multi-Team Creation (enforces Spark kill-switch + 3 owned / 5 joined cap)
          (
            !('migratedFrom' in incoming()) &&
            incoming().memberCount == 1 &&
            isPlatformNewTeamsAllowed() &&
            existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            isUserTeamCreateAfterValid(teamId) &&
            (
              !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              isUserUnderTeamCapsBefore()
            )
          ) ||
          // Legacy Single-Team Safe Migration Copy (Platform Owner admins/{uid} only)
          (
            isCaptain() &&
            ('migratedFrom' in incoming()) &&
            incoming().migratedFrom == 'main' &&
            incoming().memberCount >= 1 &&
            incoming().memberCount <= incoming().maxMembersPerTeam
          )
        );

      allow update: if isVerifiedUser() &&
        isValidTeamId(teamId) &&
        isValidMultiTeam(incoming(), teamId) &&
        incoming().id == existing().id &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        canUpdateMultiTeamDoc(teamId, existing(), incoming());

      allow delete: if false;

      // 4.1 Team Members (Public Profile ONLY — Zero health/readiness/injury/medical/PIN fields)
      match /members/{memberId} {
        allow get: if isVerifiedUser() && isValidId(memberId) && (memberId == request.auth.uid || isMultiMember(teamId));
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);

        allow create: if isVerifiedUser() &&
          isValidMultiTeamMember(request.resource.data, memberId, teamId) &&
          (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time) &&
          canCreateMultiMember(teamId, memberId, request.resource.data);

        allow update: if isVerifiedUser() &&
          isValidMultiTeamMember(request.resource.data, memberId, teamId) &&
          (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.teamId == resource.data.teamId &&
          exists(/databases/$(database)/documents/teams/$(teamId)) &&
          canUpdateMultiMember(teamId, resource.data, request.resource.data);

        allow delete: if isVerifiedUser() && isValidId(memberId) && (
          (isMultiFounder(teamId) && memberId != request.auth.uid) ||
          (memberId == request.auth.uid && !isMultiFounder(teamId))
        );

        // 4.2 Strictly Isolated Private Personal Records (Owner UID + Team Founder ONLY)
        match /private/{docId} {
          allow get: if isVerifiedUser() && isValidId(docId) && (memberId == request.auth.uid || isMultiFounder(teamId));
          allow list: if isVerifiedUser() && (memberId == request.auth.uid || isMultiFounder(teamId));
          allow create: if isVerifiedUser() &&
            isValidId(docId) &&
            isValidMultiPrivateRecord(incoming(), memberId, teamId) &&
            (memberId == request.auth.uid || isMultiFounder(teamId));
          allow update: if false;
          allow delete: if isVerifiedUser() && isValidId(docId) && (memberId == request.auth.uid || isMultiFounder(teamId));
        }
      }

      // 4.3 Team Join Requests
      match /joinRequests/{uid} {
        allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isMultiFounder(teamId));
        allow list: if isVerifiedUser() && (isMultiFounder(teamId) || resource.data.uid == request.auth.uid);

        allow create: if isVerifiedUser() &&
          uid == request.auth.uid &&
          isMultiTeamActive(teamId) &&
          !exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)) &&
          isValidMultiJoinRequest(incoming(), uid, teamId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/inviteCodes/$(incoming().inviteCode)) &&
          checkMultiJoinInviteDoc(teamId, incoming().inviteCode, incoming().status);

        allow update: if isVerifiedUser() &&
          isValidMultiJoinRequest(incoming(), uid, teamId) &&
          incoming().createdAt == existing().createdAt &&
          incoming().uid == existing().uid &&
          incoming().teamId == existing().teamId &&
          existing().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          isMultiFounder(teamId);

        allow delete: if isVerifiedUser() && isValidId(uid) && (
          isMultiFounder(teamId) ||
          (uid == request.auth.uid && existing().status in ['pending', 'approved', 'rejected'])
        );
      }

      // 4.4 Consolidated Per-Match Attendance (Self-entry isolation inside responses map)
      match /attendance/{matchKey} {
        allow get: if isVerifiedUser() && isValidId(matchKey) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);

        allow create: if isVerifiedUser() &&
          isValidConsolidatedAttendance(incoming(), matchKey, teamId) &&
          isMultiMember(teamId) && (
            isMultiFounder(teamId) ||
            (
              incoming().responses.keys().hasOnly([request.auth.uid]) &&
              request.auth.uid in incoming().responses &&
              isValidAttendanceResponseEntry(incoming().responses[request.auth.uid], request.auth.uid)
            )
          );

        allow update: if isVerifiedUser() &&
          isValidConsolidatedAttendance(incoming(), matchKey, teamId) &&
          isMultiMember(teamId) &&
          incoming().matchKey == existing().matchKey &&
          incoming().teamId == existing().teamId &&
          incoming().date == existing().date && (
            isMultiFounder(teamId) ||
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['responses', 'updatedAtMs', 'updatedAt', 'type']) &&
              incoming().responses.diff(existing().responses).affectedKeys().hasOnly([request.auth.uid]) &&
              (
                !(request.auth.uid in incoming().responses) ||
                isValidAttendanceResponseEntry(incoming().responses[request.auth.uid], request.auth.uid)
              )
            )
          );

        allow delete: if isVerifiedUser() && isValidId(matchKey) && isMultiFounder(teamId);
      }

      // 4.5 Team Matches
      match /matches/{matchId} {
        allow get: if isVerifiedUser() && isValidId(matchId) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);
        allow create: if isVerifiedUser() &&
          isValidId(matchId) &&
          isValidMatchForTeam(incoming(), teamId) && (
            isMultiFounder(teamId) ||
            (isMultiOrganizer(teamId) && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time)
          );
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(matchId) && isMultiFounder(teamId);
      }

      // 4.6 Team Reports (45-min Cooldown + Peer Verification)
      match /reports/{reportId} {
        allow get: if isVerifiedUser() && isValidId(reportId) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);

        allow create: if isVerifiedUser() &&
          isValidId(reportId) &&
          isValidReportForTeam(incoming(), teamId) &&
          isMultiMember(teamId) && (
            isMultiFounder(teamId) ||
            (
              incoming().confirmedByUids.size() == 0 &&
              incoming().verified == false &&
              incoming().createdAt == request.time &&
              incoming().playerId == request.auth.uid &&
              incoming().ownerUid == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/teams/$(teamId)/reportThrottle/$(request.auth.uid)) &&
              getAfter(/databases/$(database)/documents/teams/$(teamId)/reportThrottle/$(request.auth.uid)).data.updatedAt == request.time
            )
          );

        allow update: if isVerifiedUser() &&
          isValidId(reportId) &&
          isValidReportForTeam(incoming(), teamId) &&
          isMultiMember(teamId) &&
          incoming().teamId == existing().teamId &&
          incoming().playerId == existing().playerId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().createdAtMs == existing().createdAtMs &&
          request.auth.uid != existing().ownerUid &&
          request.auth.uid != existing().playerId &&
          !(request.auth.uid in existing().confirmedByUids) &&
          request.auth.uid in incoming().confirmedByUids &&
          incoming().confirmedByUids.hasAll(existing().confirmedByUids) &&
          incoming().confirmedByUids.size() == existing().confirmedByUids.size() + 1 &&
          incoming().verified == true &&
          incoming().diff(existing()).affectedKeys().hasOnly(['confirmedByUids', 'verified', 'updatedAt']);

        allow delete: if isVerifiedUser() && isValidId(reportId) && isMultiFounder(teamId);
      }

      // 4.7 Server-Enforced 45-Minute Report Cooldown
      match /reportThrottle/{uid} {
        allow get: if isVerifiedUser() && isValidId(uid) && (uid == request.auth.uid || isMultiFounder(teamId));
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(uid) &&
          uid == request.auth.uid &&
          isMultiMember(teamId) &&
          isValidReportThrottleForTeam(incoming(), teamId, uid);
        allow update: if isVerifiedUser() &&
          isValidId(uid) &&
          uid == request.auth.uid &&
          isMultiMember(teamId) &&
          isValidReportThrottleForTeam(incoming(), teamId, uid) &&
          request.time.toMillis() >= existing().updatedAt.toMillis() + 2700000;
        allow delete: if isVerifiedUser() && isValidId(uid) && isMultiFounder(teamId);
      }

      // 4.8 Anonymous Raw Peer Rating Ballots
      match /peerRatings/{ratingId} {
        allow get: if isVerifiedUser() && isValidId(ratingId) && resource.data.raterUid == request.auth.uid;
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(ratingId) &&
          isValidPeerBallot(incoming(), ratingId) &&
          incoming().createdAt == request.time &&
          isMultiMember(teamId) &&
          exists(/databases/$(database)/documents/teams/$(teamId)/members/$(incoming().targetId)) &&
          existsAfter(/databases/$(database)/documents/teams/$(teamId)/peerRatingStats/$(incoming().targetId));
        allow update: if isVerifiedUser() &&
          isValidId(ratingId) &&
          isValidPeerBallot(incoming(), ratingId) &&
          existing().raterUid == request.auth.uid &&
          incoming().raterUid == existing().raterUid &&
          incoming().targetId == existing().targetId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['score', 'updatedAt']) &&
          isMultiMember(teamId) &&
          existsAfter(/databases/$(database)/documents/teams/$(teamId)/peerRatingStats/$(incoming().targetId));
        allow delete: if false;
      }

      // 4.9 Aggregated Peer Rating Stats (Readable strictly when count >= 3)
      match /peerRatingStats/{targetId} {
        allow get: if isVerifiedUser() && isValidId(targetId) && isMultiMember(teamId) && resource.data.count >= 3;
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && resource.data.count >= 3 && isMultiMember(teamId);
        allow create: if isVerifiedUser() &&
          isValidPeerRatingStatForTeam(incoming(), teamId, targetId) &&
          targetId != request.auth.uid &&
          isMultiMember(teamId) &&
          exists(/databases/$(database)/documents/teams/$(teamId)/members/$(targetId)) &&
          !exists(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)) &&
          incoming().count == 1 &&
          incoming().totalScore == getAfter(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)).data.score;
        allow update: if isVerifiedUser() &&
          isValidPeerRatingStatForTeam(incoming(), teamId, targetId) &&
          targetId != request.auth.uid &&
          incoming().teamId == existing().teamId &&
          incoming().targetId == existing().targetId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['count', 'totalScore', 'updatedAt']) &&
          isMultiMember(teamId) &&
          existsAfter(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)) &&
          (
            (
              !exists(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)) &&
              incoming().count == existing().count + 1 &&
              incoming().totalScore == existing().totalScore + getAfter(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)).data.score
            ) ||
            (
              exists(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)) &&
              incoming().count == existing().count &&
              incoming().totalScore == existing().totalScore - get(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)).data.score + getAfter(/databases/$(database)/documents/teams/$(teamId)/peerRatings/$(targetId + '__' + request.auth.uid)).data.score
            )
          );
        allow delete: if isVerifiedUser() && isValidId(targetId) && isMultiFounder(teamId);
      }

      // 4.10 Founder Official Player Ratings
      match /adminRatings/{targetId} {
        allow get: if isVerifiedUser() && isValidId(targetId) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);
        allow create, update: if isVerifiedUser() && isValidAdminRatingForTeam(incoming(), teamId, targetId) && isMultiFounder(teamId);
        allow delete: if isVerifiedUser() && isValidId(targetId) && isMultiFounder(teamId);
      }

      // 4.11 Anonymous Suggestions
      match /suggestions/{suggestionId} {
        allow get: if isVerifiedUser() && isValidId(suggestionId) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);
        allow create: if isVerifiedUser() &&
          isValidId(suggestionId) &&
          isValidSuggestionForTeam(incoming(), teamId) &&
          isMultiMember(teamId) &&
          (isMultiFounder(teamId) || incoming().createdAt == request.time);
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(suggestionId) && isMultiFounder(teamId);
      }

      // 4.12 Team Tactics Board
      match /tactics/{docId} {
        allow get: if isVerifiedUser() && docId == 'current' && isMultiMember(teamId);
        allow list: if false;
        allow create: if isVerifiedUser() &&
          docId == 'current' &&
          isValidTacticsForTeam(incoming(), teamId) &&
          (isMultiFounderAfter(teamId) || canMultiPublishLineup(teamId));
        allow update: if isVerifiedUser() &&
          docId == 'current' &&
          isValidTacticsForTeam(incoming(), teamId) &&
          canMultiPublishLineup(teamId);
        allow delete: if false;
      }

      // 4.13 Team Lineup Votes
      match /lineupVotes/{uid} {
        allow get: if isVerifiedUser() && isValidId(uid) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);
        allow create, update: if isVerifiedUser() &&
          isValidId(uid) &&
          uid == request.auth.uid &&
          isMultiMember(teamId) &&
          isValidLineupVoteForTeam(incoming(), teamId, uid);
        allow delete: if isVerifiedUser() && isValidId(uid) && (isMultiFounder(teamId) || uid == request.auth.uid);
      }

      // 4.14 Team Pitch Session (Schedule & Aggregate Fee Totals)
      match /pitchSessions/{docId} {
        allow get: if isVerifiedUser() && docId == 'current' && isMultiMember(teamId);
        allow list: if false;
        allow create, update: if isVerifiedUser() &&
          docId == 'current' &&
          isValidPitchSessionForTeam(incoming(), teamId) &&
          (isMultiFounder(teamId) || isMultiOrganizer(teamId));
        allow delete: if false;
      }

      // 4.15 Private Per-Player Pitch Payments (Owner + Team Founder + Team Organizers ONLY)
      match /pitchPayments/{paymentId} {
        allow get: if isVerifiedUser() && isValidId(paymentId) &&
          (resource.data.ownerUid == request.auth.uid || isMultiFounder(teamId) || isMultiOrganizer(teamId));
        allow list: if isVerifiedUser() &&
          resource.data.teamId == teamId &&
          (resource.data.ownerUid == request.auth.uid || isMultiFounder(teamId) || isMultiOrganizer(teamId));
        allow create, update: if isVerifiedUser() &&
          isValidId(paymentId) &&
          isValidPitchPaymentForTeam(incoming(), teamId, paymentId) &&
          (isMultiFounder(teamId) || isMultiOrganizer(teamId));
        allow delete: if isVerifiedUser() && isValidId(paymentId) && (isMultiFounder(teamId) || isMultiOrganizer(teamId));
      }

      // 4.16 Decentralized Match Verification Sessions
      match /matchSessions/{sessionId} {
        allow get: if isVerifiedUser() && isValidId(sessionId) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);

        allow create: if isVerifiedUser() &&
          isValidMatchSessionForTeam(incoming(), teamId, sessionId) &&
          isMultiMember(teamId) &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().status == 'draft' &&
          incoming().votingOpen == false &&
          incoming().confirmers.size() == 1 &&
          request.auth.uid in incoming().confirmers &&
          request.auth.uid in incoming().participantIds &&
          incoming().voterUids.size() == 0;

        allow update: if isVerifiedUser() &&
          isValidMatchSessionForTeam(incoming(), teamId, sessionId) &&
          isMultiMember(teamId) &&
          incoming().id == existing().id &&
          incoming().teamId == existing().teamId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().date == existing().date &&
          incoming().opponent == existing().opponent &&
          incoming().pitchMode == existing().pitchMode &&
          incoming().ourScore == existing().ourScore &&
          incoming().oppScore == existing().oppScore &&
          incoming().result == existing().result &&
          incoming().participantIds == existing().participantIds && (
            (
              existing().status == 'draft' &&
              request.auth.uid in existing().participantIds &&
              !(request.auth.uid in existing().confirmers) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['confirmers', 'status', 'votingOpen', 'updatedAt']) &&
              incoming().confirmers.size() == existing().confirmers.size() + 1 &&
              incoming().confirmers.hasAll(existing().confirmers) &&
              request.auth.uid in incoming().confirmers && (
                (incoming().confirmers.size() >= 3 && incoming().status == 'verified' && incoming().votingOpen == true) ||
                (incoming().confirmers.size() < 3 && incoming().status == 'draft' && incoming().votingOpen == false)
              )
            ) ||
            (
              existing().status == 'verified' &&
              existing().votingOpen == true &&
              request.auth.uid in existing().participantIds &&
              !(request.auth.uid in existing().voterUids) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['voterUids', 'updatedAt']) &&
              incoming().voterUids.size() == existing().voterUids.size() + 1 &&
              incoming().voterUids.hasAll(existing().voterUids) &&
              request.auth.uid in incoming().voterUids
            ) ||
            (
              isMultiFounder(teamId) &&
              existing().status == 'verified' &&
              existing().votingOpen == true &&
              incoming().diff(existing()).affectedKeys().hasOnly(['votingOpen', 'updatedAt']) &&
              incoming().votingOpen == false
            )
          );

        allow delete: if isVerifiedUser() && isValidId(sessionId) && isMultiFounder(teamId);
      }

      // 4.17 Private Secret Match Ballots
      match /matchVoteBallots/{ballotId} {
        allow get: if isVerifiedUser() && isValidId(ballotId) && resource.data.voterUid == request.auth.uid;
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(ballotId) &&
          isValidMatchVoteBallot(incoming(), ballotId) &&
          isMultiMember(teamId) &&
          exists(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(incoming().sessionId)) &&
          get(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(incoming().sessionId)).data.status == 'verified' &&
          get(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(incoming().sessionId)).data.votingOpen == true &&
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(incoming().sessionId)).data.participantIds &&
          incoming().targetId in get(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(incoming().sessionId)).data.participantIds &&
          existsAfter(/databases/$(database)/documents/teams/$(teamId)/matchVoteTallies/$(incoming().sessionId + '__' + incoming().targetId));

        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(ballotId) && isMultiFounder(teamId);
      }

      // 4.18 Anonymous 10-Bucket Match Vote Tallies (50% Quorum Lock)
      match /matchVoteTallies/{tallyId} {
        allow get: if isVerifiedUser() &&
          isValidId(tallyId) &&
          isMultiMember(teamId) &&
          resource.data.count >= 2 &&
          exists(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(resource.data.sessionId)) &&
          get(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(resource.data.sessionId)).data.status == 'verified' &&
          (
            get(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(resource.data.sessionId)).data.voterUids.size() * 2 >=
            get(/databases/$(database)/documents/teams/$(teamId)/matchSessions/$(resource.data.sessionId)).data.participantIds.size()
          );
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidMatchVoteTallyForTeam(incoming(), teamId, tallyId) &&
          incoming().targetId != request.auth.uid &&
          isMultiMember(teamId) &&
          !exists(/databases/$(database)/documents/teams/$(teamId)/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/teams/$(teamId)/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
          incoming().count == 1 &&
          incoming().totalScore == getAfter(/databases/$(database)/documents/teams/$(teamId)/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)).data.score;

        allow update: if isVerifiedUser() &&
          isValidMatchVoteTallyForTeam(incoming(), teamId, tallyId) &&
          incoming().targetId != request.auth.uid &&
          incoming().teamId == existing().teamId &&
          incoming().sessionId == existing().sessionId &&
          incoming().targetId == existing().targetId &&
          incoming().eligibleCount == existing().eligibleCount &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'count', 'totalScore', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'h7', 'h8', 'h9', 'h10', 'updatedAt'
          ]) &&
          isMultiMember(teamId) &&
          !exists(/databases/$(database)/documents/teams/$(teamId)/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/teams/$(teamId)/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)) &&
          incoming().count == existing().count + 1 &&
          incoming().totalScore == existing().totalScore + getAfter(/databases/$(database)/documents/teams/$(teamId)/matchVoteBallots/$(incoming().sessionId + '__' + incoming().targetId + '__' + request.auth.uid)).data.score &&
          incoming().h1 >= existing().h1 &&
          incoming().h2 >= existing().h2 &&
          incoming().h3 >= existing().h3 &&
          incoming().h4 >= existing().h4 &&
          incoming().h5 >= existing().h5 &&
          incoming().h6 >= existing().h6 &&
          incoming().h7 >= existing().h7 &&
          incoming().h8 >= existing().h8 &&
          incoming().h9 >= existing().h9 &&
          incoming().h10 >= existing().h10;

        allow delete: if isVerifiedUser() && isValidId(tallyId) && isMultiFounder(teamId);
      }

      // 4.19 Random 2-Teammate Peer Mission Verification
      match /missionClaims/{claimId} {
        allow get: if isVerifiedUser() && isValidId(claimId) && isMultiMember(teamId);
        allow list: if isVerifiedUser() && resource.data.teamId == teamId && isMultiMember(teamId);

        allow create: if isVerifiedUser() &&
          isValidMissionClaimForTeam(incoming(), teamId, claimId) &&
          isMultiMember(teamId) &&
          incoming().claimantUid == request.auth.uid &&
          incoming().status == 'pending' &&
          incoming().approverUids.size() == 0 &&
          incoming().rejectorUids.size() == 0 &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/teams/$(teamId)/members/$(incoming().verifierUids[0])) &&
          exists(/databases/$(database)/documents/teams/$(teamId)/members/$(incoming().verifierUids[1]));

        allow update: if isVerifiedUser() &&
          isValidMissionClaimForTeam(incoming(), teamId, claimId) &&
          isMultiMember(teamId) &&
          existing().status == 'pending' &&
          incoming().id == existing().id &&
          incoming().teamId == existing().teamId &&
          incoming().missionId == existing().missionId &&
          incoming().missionTitle == existing().missionTitle &&
          incoming().xpReward == existing().xpReward &&
          incoming().claimantUid == existing().claimantUid &&
          incoming().claimantName == existing().claimantName &&
          incoming().note == existing().note &&
          incoming().verifierUids == existing().verifierUids &&
          incoming().createdAt == existing().createdAt &&
          request.auth.uid != existing().claimantUid &&
          request.auth.uid in existing().verifierUids &&
          !(request.auth.uid in existing().approverUids) &&
          !(request.auth.uid in existing().rejectorUids) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['approverUids', 'rejectorUids', 'status', 'updatedAt']) && (
            (
              incoming().rejectorUids == existing().rejectorUids &&
              incoming().approverUids.size() == existing().approverUids.size() + 1 &&
              incoming().approverUids.hasAll(existing().approverUids) &&
              request.auth.uid in incoming().approverUids && (
                (incoming().approverUids.size() == 2 && incoming().status == 'verified') ||
                (incoming().approverUids.size() < 2 && incoming().status == 'pending')
              )
            ) ||
            (
              incoming().approverUids == existing().approverUids &&
              incoming().rejectorUids.size() == existing().rejectorUids.size() + 1 &&
              incoming().rejectorUids.hasAll(existing().rejectorUids) &&
              request.auth.uid in incoming().rejectorUids &&
              incoming().status == 'rejected'
            )
          );

        allow delete: if isVerifiedUser() && isValidId(claimId) && isMultiFounder(teamId);
      }

      // 4.20 Team Football Library
      match /footballLibrary/{articleId} {
        allow get: if isVerifiedUser() &&
          isValidId(articleId) &&
          isMultiMember(teamId) &&
          (resource.data.published == true || isMultiFounder(teamId));

        allow list: if isVerifiedUser() &&
          resource.data.teamId == teamId &&
          isMultiMember(teamId) &&
          (resource.data.published == true || isMultiFounder(teamId));

        allow create: if isVerifiedUser() &&
          isValidLibraryArticleForTeam(incoming(), teamId, articleId) &&
          incoming().createdAt == request.time &&
          isMultiFounder(teamId);

        allow update: if isVerifiedUser() &&
          isValidLibraryArticleForTeam(incoming(), teamId, articleId) &&
          incoming().createdAt == existing().createdAt &&
          incoming().id == existing().id &&
          incoming().teamId == existing().teamId &&
          isMultiFounder(teamId);

        allow delete: if isVerifiedUser() && isValidId(articleId) && isMultiFounder(teamId);
      }

      // 4.21 Team-Scoped Private Founder Audit Logs for Invite Codes
      match /inviteAdminLogs/{code} {
        allow get, list: if isMultiFounder(teamId);
        allow create: if isVerifiedUser() && isValidInviteAdminLog(incoming(), code) && (isMultiFounder(teamId) || isMultiFounderAfter(teamId));
        allow update: if isMultiFounder(teamId) && isValidInviteAdminLog(incoming(), code);
        allow delete: if isMultiFounder(teamId) && isValidInviteCodeStr(code);
      }
    }
  }
}
