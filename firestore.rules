rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== 0. GLOBAL DEFAULT-DENY SAFETY NET ====================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== 1. HARDENED PRIMITIVES & IDENTITY ====================
    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]{1,128}$');
    }

    function isValidTeamId(tid) {
      return tid is string && tid != 'main' && tid.matches('^[a-zA-Z0-9_\\-]{2,64}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isCaptain() {
      return isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTeamMember() {
      return isCaptain() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/players/$(request.auth.uid)));
    }

    function isOrganizer() {
      return isTeamMember() &&
        exists(/databases/$(database)/documents/settings/team) &&
        ('organizerUids' in get(/databases/$(database)/documents/settings/team).data) &&
        (request.auth.uid in get(/databases/$(database)/documents/settings/team).data.organizerUids);
    }

    function canPublishLineup() {
      return isCaptain() || (
        isTeamMember() && (
          !exists(/databases/$(database)/documents/settings/team) ||
          !('lineupPermission' in get(/databases/$(database)/documents/settings/team).data) ||
          get(/databases/$(database)/documents/settings/team).data.lineupPermission == 'all' ||
          isOrganizer()
        )
      );
    }

    // Multi-Team Helpers (Strictly Scoped Per teamId — Zero Cross-Team Leakage)
    function isMultiFounder(tid) {
      return isVerifiedUser() &&
        isValidTeamId(tid) &&
        exists(/databases/$(database)/documents/teams/$(tid)) &&
        get(/databases/$(database)/documents/teams/$(tid)).data.founderUid == request.auth.uid;
    }

    function isMultiFounderAfter(tid) {
      return isVerifiedUser() &&
        isValidTeamId(tid) &&
        existsAfter(/databases/$(database)/documents/teams/$(tid)) &&
        getAfter(/databases/$(database)/documents/teams/$(tid)).data.founderUid == request.auth.uid;
    }

    function isMultiMember(tid) {
      return isMultiFounder(tid) || (
        isVerifiedUser() &&
        isValidTeamId(tid) &&
        exists(/databases/$(database)/documents/teams/$(tid)/members/$(request.auth.uid))
      );
    }

    function isMultiOrganizer(tid) {
      return isMultiMember(tid) &&
        exists(/databases/$(database)/documents/teams/$(tid)) &&
        ('organizerUids' in get(/databases/$(database)/documents/teams/$(tid)).data) &&
        (request.auth.uid in get(/databases/$(database)/documents/teams/$(tid)).data.organizerUids);
    }

    function hasMultiJoinRequest(tid) {
      return isVerifiedUser() &&
        isValidTeamId(tid) &&
        exists(/databases/$(database)/documents/teams/$(tid)/joinRequests/$(request.auth.uid));
    }

    function canMultiPublishLineup(tid) {
      return isMultiFounder(tid) || (
        isMultiMember(tid) && (
          !exists(/databases/$(database)/documents/teams/$(tid)) ||
          !('lineupPublishMode' in get(/databases/$(database)/documents/teams/$(tid)).data) ||
          get(/databases/$(database)/documents/teams/$(tid)).data.lineupPublishMode == 'all' ||
          isMultiOrganizer(tid)
        )
      );
    }

    function isPlatformNewTeamsAllowed() {
      return !exists(/databases/$(database)/documents/platform/config) ||
        !('allowNewTeams' in get(/databases/$(database)/documents/platform/config).data) ||
        get(/databases/$(database)/documents/platform/config).data.allowNewTeams == true;
    }

    function isMultiTeamActive(tid) {
      return exists(/databases/$(database)/documents/teams/$(tid)) &&
        get(/databases/$(database)/documents/teams/$(tid)).data.deletedAt == null;
    }

    function isUserUnderTeamCapsBefore() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (!('ownedTeamIds' in u) || u.ownedTeamIds.size() < 3) &&
        (!('teamIds' in u) || u.teamIds.size() < 5);
    }

    function isUserTeamCreateAfterValid(tid) {
      let uAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (tid in uAfter.ownedTeamIds) &&
        (tid in uAfter.teamIds) &&
        uAfter.ownedTeamIds.size() <= 3 &&
        uAfter.teamIds.size() <= 5;
    }

    function isUserInstantJoinAfterValid(tid) {
      let uAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (tid in uAfter.teamIds) && uAfter.teamIds.size() <= 5;
    }

    function checkMultiInstantJoin(tid) {
      let jrAfter = getAfter(/databases/$(database)/documents/teams/$(tid)/joinRequests/$(request.auth.uid)).data;
      let inv = get(/databases/$(database)/documents/inviteCodes/$(jrAfter.inviteCode)).data;
      return jrAfter.createdAt == request.time &&
        jrAfter.status == 'approved' &&
        inv.teamId == tid &&
        inv.active == true &&
        inv.status == 'active' &&
        request.time.toMillis() < inv.expiresAtMs &&
        inv.requireApproval == false &&
        inv.isMemberShareCode != true;
    }

    function canCreateMultiMember(tid, memberId, data) {
      let d = data;
      return exists(/databases/$(database)/documents/teams/$(tid))
        ? canCreateMultiMemberInExistingTeam(tid, memberId, d)
        : (
            memberId == request.auth.uid &&
            d.ownerUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/teams/$(tid)).data.founderUid == request.auth.uid
          );
    }

    function canCreateMultiMemberInExistingTeam(tid, memberId, data) {
      let d = data;
      let team = get(/databases/$(database)/documents/teams/$(tid)).data;
      return team.founderUid == request.auth.uid || (
        memberId == request.auth.uid &&
        d.ownerUid == request.auth.uid &&
        d.role == 'member' &&
        d.isOrganizer == false &&
        team.deletedAt == null &&
        team.joinMode == 'instant' &&
        team.memberCount < team.maxMembersPerTeam &&
        getAfter(/databases/$(database)/documents/teams/$(tid)).data.memberCount == team.memberCount + 1 &&
        checkMultiInstantJoin(tid)
      );
    }

    function canUpdateMultiMember(tid, prev, next) {
      let team = get(/databases/$(database)/documents/teams/$(tid)).data;
      let diff = next.diff(prev).affectedKeys();
      return team.founderUid == request.auth.uid || (
        prev.ownerUid == request.auth.uid &&
        next.ownerUid == prev.ownerUid &&
        next.role == prev.role &&
        next.isOrganizer == prev.isOrganizer &&
        team.deletedAt == null &&
        diff.hasOnly([
          'name', 'jersey', 'age', 'height', 'weight', 'foot',
          'primaryPos', 'secondaryPos', 'photo', 'hasPhoto', 'photoZoom', 'photoY',
          'skills', 'stats6', 'roleOverride', 'top3Strengths', 'weak3Points',
          'seasonGoal', 'availableStatus', 'roleModelStarId', 'updatedAtMs', 'updatedAt'
        ]) && (
          !diff.hasAny(['skills', 'stats6']) ||
          team.lockSkills == false
        )
      );
    }

    function checkMultiJoinInviteDoc(tid, code, reqStatus) {
      let inv = get(/databases/$(database)/documents/inviteCodes/$(code)).data;
      let invAfter = getAfter(/databases/$(database)/documents/inviteCodes/$(code)).data;
      return inv.teamId == tid &&
        inv.active == true &&
        inv.status == 'active' &&
        request.time.toMillis() < inv.expiresAtMs &&
        inv.usedCount < inv.maxUses &&
        invAfter.usedCount == inv.usedCount + 1 && (
          reqStatus == 'pending' ||
          (
            reqStatus == 'approved' &&
            inv.requireApproval == false &&
            inv.isMemberShareCode != true
          )
        );
    }

    function isValidInviteUsageIncrement(prev, next) {
      return prev.active == true &&
        prev.status == 'active' &&
        request.time.toMillis() < prev.expiresAtMs &&
        prev.usedCount < prev.maxUses &&
        next.diff(prev).affectedKeys().hasOnly(['usedCount', 'active', 'status', 'updatedAt']) &&
        next.usedCount == prev.usedCount + 1 &&
        next.active == (next.usedCount < prev.maxUses) &&
        next.status == (next.usedCount >= prev.maxUses ? 'completed' : 'active');
    }

    function canUpdateMultiTeamDoc(tid, prev, next) {
      let diff = next.diff(prev).affectedKeys();
      return prev.deletedAt == null && (
        (
          prev.founderUid == request.auth.uid && (
            // Action 1: Founder updates team settings / organizers / maxMembersPerTeam
            (
              next.founderUid == prev.founderUid &&
              next.memberCount == prev.memberCount &&
              next.deletedAt == prev.deletedAt &&
              diff.hasOnly([
                'teamName', 'appName', 'primaryColor', 'secondaryColor', 'logo',
                'inviteCode', 'memberShareCode', 'joinMode', 'lineupPublishMode',
                'lockSkills', 'maxMembersPerTeam', 'organizerUids',
                'defaultCurrency', 'defaultPitchCost', 'updatedAtMs', 'updatedAt'
              ])
            ) ||
            // Action 2: Founder transfers leadership to an existing team member
            (
              next.founderUid != prev.founderUid &&
              exists(/databases/$(database)/documents/teams/$(tid)/members/$(next.founderUid)) &&
              (request.auth.uid in next.organizerUids) &&
              diff.hasOnly(['founderUid', 'organizerUids', 'updatedAtMs', 'updatedAt'])
            ) ||
            // Action 3: Founder increments memberCount (+1) on member add / join approval
            (
              prev.memberCount < prev.maxMembersPerTeam &&
              next.memberCount == prev.memberCount + 1 &&
              diff.hasOnly(['memberCount', 'updatedAt'])
            ) ||
            // Action 4: Founder decrements memberCount (-1) on member removal
            (
              next.memberCount == prev.memberCount - 1 &&
              diff.hasOnly(['memberCount', 'organizerUids', 'updatedAt'])
            ) ||
            // Action 5: Founder soft-deletes team (deletedAt = request.time)
            (
              next.deletedAt == request.time &&
              diff.hasOnly(['deletedAt', 'updatedAtMs', 'updatedAt'])
            )
          )
        ) ||
        // Action 6: Tier 2 Team Organizer limited settings update (never inviteCode, founderUid, joinMode, or lockSkills)
        (
          (request.auth.uid in prev.organizerUids) &&
          exists(/databases/$(database)/documents/teams/$(tid)/members/$(request.auth.uid)) &&
          diff.hasOnly([
            'teamName', 'logo', 'defaultCurrency', 'defaultPitchCost',
            'lineupPublishMode', 'updatedAtMs', 'updatedAt'
          ])
        ) ||
        // Action 7: Atomic Instant Join memberCount (+1) paired with new member & approved joinRequest
        (
          prev.joinMode == 'instant' &&
          prev.memberCount < prev.maxMembersPerTeam &&
          next.memberCount == prev.memberCount + 1 &&
          diff.hasOnly(['memberCount', 'updatedAt']) &&
          !exists(/databases/$(database)/documents/teams/$(tid)/members/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/teams/$(tid)/members/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/teams/$(tid)/joinRequests/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          isUserInstantJoinAfterValid(tid)
        ) ||
        // Action 8: Atomic Member Self-Leave memberCount (-1) paired with self-deletion
        (
          request.auth.uid != prev.founderUid &&
          next.memberCount == prev.memberCount - 1 &&
          diff.hasOnly(['memberCount', 'organizerUids', 'updatedAt']) &&
          !(request.auth.uid in next.organizerUids) &&
          prev.organizerUids.hasAll(next.organizerUids) &&
          exists(/databases/$(database)/documents/teams/$(tid)/members/$(request.auth.uid)) &&
          !existsAfter(/databases/$(database)/documents/teams/$(tid)/members/$(request.auth.uid))
        )
      );
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 5 && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidHexColor(c) {
      return c is string && c.size() == 7 && c.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidInviteCodeStr(c) {
      return c is string && c.size() >= 8 && c.size() <= 20 && c.matches('^[A-Z0-9\\-]+$');
    }

    function isValidReferralCodeStr(r) {
      return r is string && r.size() <= 32 && (r == '' || r.matches('^REF-[A-Z0-9]{4,16}$'));
    }

    function isValidPos(p) {
      return p in ['حارس مرمى', 'مدافع', 'لاعب وسط', 'جناح', 'مهاجم'];
    }

    function isValidSecondaryPos(p) {
      return p in ['لا يوجد', 'حارس مرمى', 'مدافع', 'لاعب وسط', 'جناح', 'مهاجم'];
    }

    function isValidFoot(f) {
      return f in ['يمين', 'يسار', 'كلتاهما'];
    }

    function isValidSkillVal(v) {
      let x = v;
      return x >= 1 && x <= 10;
    }

    function isValidSkillsMap(sk) {
      let m = sk;
      return m is map &&
        m.size() == 10 &&
        m.speed >= 1 && m.speed <= 10 &&
        m.shooting >= 1 && m.shooting <= 10 &&
        m.passing >= 1 && m.passing <= 10 &&
        m.dribbling >= 1 && m.dribbling <= 10 &&
        m.defending >= 1 && m.defending <= 10 &&
        m.stamina >= 1 && m.stamina <= 10 &&
        m.vision >= 1 && m.vision <= 10 &&
        m.teamwork >= 1 && m.teamwork <= 10 &&
        m.control >= 1 && m.control <= 10 &&
        m.positioning >= 1 && m.positioning <= 10;
    }

    function isValidStat6Val(v) {
      let x = v;
      return x is int && x >= 40 && x <= 85;
    }

    function isValidStats6Map(s) {
      let m = s;
      return m is map &&
        m.size() == 6 &&
        m.PAC is int && m.PAC >= 40 && m.PAC <= 85 &&
        m.SHO is int && m.SHO >= 40 && m.SHO <= 85 &&
        m.PAS is int && m.PAS >= 40 && m.PAS <= 85 &&
        m.DRI is int && m.DRI >= 40 && m.DRI <= 85 &&
        m.DEF is int && m.DEF >= 40 && m.DEF <= 85 &&
        m.PHY is int && m.PHY >= 40 && m.PHY <= 85 &&
        (m.PAC + m.SHO + m.PAS + m.DRI + m.DEF + m.PHY) == 360;
    }

    function isValidRoleOverride(r) {
      return r is string && r in ['', 'ST', 'CAM_WINGER', 'CM', 'DEF_CB', 'GK'];
    }

    function isValidVoteBucket(v) {
      return v is int && v >= 0 && v <= 50;
    }

    // ==================== 2. VALIDATION BLUEPRINTS ====================

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['allowNewTeams', 'updatedAt']) &&
        data.keys().hasOnly(['allowNewTeams', 'updatedAt']) &&
        data.allowNewTeams is bool &&
        data.updatedAt == request.time;
    }

    function isValidUserAccount(data, uid) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'teamIds', 'ownedTeamIds', 'activeTeamId',
          'pendingJoinTeamId', 'migratedToTeamId', 'privacyAcceptedAt',
          'privacyNoticeVersion', 'updatedAt'
        ]) &&
        isValidId(uid) &&
        data.uid == uid &&
        data.uid == request.auth.uid &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80)) &&
        (!('teamIds' in data) || (data.teamIds is list && data.teamIds.size() <= 5)) &&
        (!('ownedTeamIds' in data) || (data.ownedTeamIds is list && data.ownedTeamIds.size() <= 3)) &&
        (!('activeTeamId' in data) || (data.activeTeamId is string && data.activeTeamId.size() <= 64 && (data.activeTeamId == '' || isValidId(data.activeTeamId)))) &&
        (!('pendingJoinTeamId' in data) || (data.pendingJoinTeamId is string && data.pendingJoinTeamId.size() <= 64 && (data.pendingJoinTeamId == '' || isValidId(data.pendingJoinTeamId)))) &&
        (!('migratedToTeamId' in data) || (data.migratedToTeamId is string && data.migratedToTeamId.size() <= 64 && (data.migratedToTeamId == '' || isValidId(data.migratedToTeamId)))) &&
        (!('privacyAcceptedAt' in data) || (data.privacyAcceptedAt is number && data.privacyAcceptedAt >= 0)) &&
        (!('privacyNoticeVersion' in data) || (data.privacyNoticeVersion is string && data.privacyNoticeVersion.size() <= 40)) &&
        data.updatedAt == request.time;
    }

    function isValidMultiTeam(data, tid) {
      let d = data;
      return isValidTeamId(tid) &&
        d.keys().hasOnly([
          'id', 'teamName', 'appName', 'founderUid', 'organizerUids',
          'primaryColor', 'secondaryColor', 'logo', 'joinMode', 'lineupPublishMode',
          'defaultCurrency', 'defaultPitchCost', 'maxMembersPerTeam', 'memberCount',
          'inviteCode', 'memberShareCode', 'lockSkills', 'deletedAt', 'migratedFrom',
          'createdAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ]) &&
        d.id == tid &&
        d.teamName is string && d.teamName.size() >= 1 && d.teamName.size() <= 80 &&
        d.appName is string && d.appName.size() >= 1 && d.appName.size() <= 60 &&
        isValidId(d.founderUid) &&
        d.organizerUids is list && d.organizerUids.size() <= 30 &&
        isValidHexColor(d.primaryColor) &&
        isValidHexColor(d.secondaryColor) &&
        (!('logo' in d) || (d.logo is string && d.logo.size() <= 68500 && (d.logo == '' || d.logo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')))) &&
        d.joinMode in ['approval', 'instant'] &&
        d.lineupPublishMode in ['organizers', 'all'] &&
        (!('defaultCurrency' in d) || (d.defaultCurrency is string && d.defaultCurrency.size() >= 1 && d.defaultCurrency.size() <= 20)) &&
        (!('defaultPitchCost' in d) || (d.defaultPitchCost >= 0 && d.defaultPitchCost <= 100000)) &&
        d.maxMembersPerTeam is int && d.maxMembersPerTeam >= 6 && d.maxMembersPerTeam <= 100 &&
        d.memberCount is int && d.memberCount >= 0 && d.memberCount <= d.maxMembersPerTeam &&
        isValidInviteCodeStr(d.inviteCode) &&
        isValidInviteCodeStr(d.memberShareCode) &&
        d.lockSkills is bool &&
        (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt is timestamp) &&
        (!('migratedFrom' in d) || d.migratedFrom == 'main') &&
        (!('createdAtMs' in d) || d.createdAtMs >= 0) &&
        (!('updatedAtMs' in d) || d.updatedAtMs >= 0) &&
        (!('createdAt' in d) || d.createdAt is timestamp) &&
        d.updatedAt == request.time;
    }

    // Strict whitelist mathematically excludes all health/readiness/injury/medical/PIN keys;
    // lean CEL checks keep full 30-key member profiles well below Firestore's 1000-expression limit.
    function isValidMultiTeamMember(data, memberId, tid) {
      let d = data;
      return isValidId(memberId) &&
        isValidTeamId(tid) &&
        d.keys().hasOnly([
          'id', 'uid', 'ownerUid', 'teamId', 'name', 'role', 'isOrganizer',
          'jersey', 'age', 'height', 'weight', 'foot', 'primaryPos', 'secondaryPos',
          'photo', 'hasPhoto', 'photoZoom', 'photoY', 'skills', 'stats6', 'roleOverride',
          'top3Strengths', 'weak3Points', 'seasonGoal', 'availableStatus',
          'roleModelStarId', 'joinedAtMs', 'updatedAtMs', 'createdAt', 'updatedAt'
        ]) &&
        d.id == memberId &&
        d.uid == memberId &&
        d.teamId == tid &&
        (d.ownerUid == '' || isValidId(d.ownerUid)) &&
        d.name is string && d.name.size() >= 1 && d.name.size() <= 80 &&
        d.role in ['founder', 'organizer', 'member'] &&
        d.isOrganizer is bool &&
        d.jersey >= 0 && d.jersey <= 99 &&
        (!('age' in d) || (d.age >= 10 && d.age <= 70)) &&
        (!('height' in d) || (d.height >= 100 && d.height <= 230)) &&
        (!('weight' in d) || (d.weight >= 30 && d.weight <= 160)) &&
        d.get('foot', 'يمين') in ['يمين', 'يسار', 'كلتاهما'] &&
        d.primaryPos in ['حارس مرمى', 'مدافع', 'لاعب وسط', 'جناح', 'مهاجم'] &&
        d.get('secondaryPos', 'لا يوجد') in ['لا يوجد', 'حارس مرمى', 'مدافع', 'لاعب وسط', 'جناح', 'مهاجم'] &&
        (!('photo' in d) || (d.photo is string && d.photo.size() <= 250000 && (d.photo == '' || d.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')))) &&
        d.get('hasPhoto', false) is bool &&
        (!('photoZoom' in d) || (d.photoZoom >= 90 && d.photoZoom <= 160)) &&
        (!('photoY' in d) || (d.photoY >= 0 && d.photoY <= 60)) &&
        isValidSkillsMap(d.skills) &&
        (!('stats6' in d) || isValidStats6Map(d.stats6)) &&
        d.get('roleOverride', '') in ['', 'ST', 'CAM_WINGER', 'CM', 'DEF_CB', 'GK'] &&
        (!('top3Strengths' in d) || (d.top3Strengths is string && d.top3Strengths.size() <= 200)) &&
        (!('weak3Points' in d) || (d.weak3Points is string && d.weak3Points.size() <= 200)) &&
        (!('seasonGoal' in d) || (d.seasonGoal is string && d.seasonGoal.size() <= 200)) &&
        d.availableStatus in ['متاح', 'غير متاح'] &&
        d.get('roleModelStarId', '').matches('^[a-z0-9_]{0,40}$') &&
        d.get('joinedAtMs', 0) >= 0 &&
        d.get('updatedAtMs', 0) >= 0 &&
        (!('createdAt' in d) || d.createdAt is timestamp) &&
        d.updatedAt == request.time;
    }

    function isValidMultiPrivateRecord(data, memberId, tid) {
      return isValidId(memberId) &&
        isValidTeamId(tid) &&
        data.keys().hasAll(['kind', 'uid', 'teamId', 'date', 'updatedAtMs', 'createdAt']) &&
        data.uid == memberId &&
        data.teamId == tid &&
        isValidDateStr(data.date) &&
        data.updatedAtMs is int && data.updatedAtMs >= 0 &&
        data.createdAt == request.time && (
          (
            data.kind == 'readiness' &&
            data.keys().hasAll(['kind', 'uid', 'teamId', 'date', 'sleep', 'fatigue', 'mood', 'updatedAtMs', 'createdAt']) &&
            data.keys().hasOnly(['kind', 'uid', 'teamId', 'date', 'sleep', 'fatigue', 'mood', 'updatedAtMs', 'createdAt']) &&
            data.sleep is number && data.sleep >= 1 && data.sleep <= 10 &&
            data.fatigue is number && data.fatigue >= 1 && data.fatigue <= 10 &&
            data.mood is number && data.mood >= 1 && data.mood <= 10
          ) || (
            data.kind == 'injury' &&
            data.keys().hasAll(['kind', 'uid', 'teamId', 'type', 'location', 'severity', 'date', 'expectedReturn', 'updatedAtMs', 'createdAt']) &&
            data.keys().hasOnly(['kind', 'uid', 'teamId', 'type', 'location', 'severity', 'date', 'expectedReturn', 'updatedAtMs', 'createdAt']) &&
            data.type is string && data.type.size() >= 1 && data.type.size() <= 80 &&
            data.location is string && data.location.size() >= 1 && data.location.size() <= 100 &&
            data.severity in ['خفيفة', 'متوسطة', 'شديدة'] &&
            isValidDateStr(data.expectedReturn)
          )
        );
    }

    function isValidMultiJoinRequest(data, uid, tid) {
      return data.keys().hasAll(['uid', 'teamId', 'name', 'jersey', 'primaryPos', 'inviteCode', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'teamId', 'name', 'jersey', 'primaryPos', 'stats6', 'roleOverride', 'inviteCode', 'referredBy', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(uid) &&
        isValidTeamId(tid) &&
        data.uid == uid &&
        data.teamId == tid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.jersey is number && data.jersey >= 1 && data.jersey <= 99 &&
        isValidPos(data.primaryPos) &&
        (!('stats6' in data) || isValidStats6Map(data.stats6)) &&
        (!('roleOverride' in data) || isValidRoleOverride(data.roleOverride)) &&
